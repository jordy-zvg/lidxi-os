# =============================================================================
# LidxiOS — variables de entorno
# Copia este archivo a .env.local en la raíz y en cada app que lo necesite.
# Las vars con NEXT_PUBLIC_ están expuestas al cliente del navegador.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Para desarrollo local con `supabase start`, los valores por defecto del CLI son:
#   URL:              http://127.0.0.1:54321
#   ANON_KEY:         (lo imprime `supabase start`)
#   SERVICE_ROLE_KEY: (lo imprime `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth custom (PIN + JWT propio) ----------------------------------------
# Secret usado para firmar JWTs de sesión de empleados.
# DEBE ser el mismo "JWT secret" que imprime `supabase start` para que
# PostgREST acepte nuestros JWTs y RLS lea las claims.
JWT_SECRET=
JWT_ISSUER=lidxi-os
JWT_AUDIENCE=lidxi-oms

# --- Contexto de estación (mientras no exista tabla `stations`) -------------
# Cada dispositivo OMS pertenece a un branch específico. El UUID b001 del
# seed corresponde a Juriquilla; cuando agregues branches, asigna el suyo.
BRANCH_ID=00000000-0000-0000-0000-00000000b001
STATION_ID=default-station-1

# --- Modo mock para integraciones -------------------------------------------
# Cuando es "true", los clientes de Uber/Rappi/Didi/Stripe responden con datos
# de mock en vez de llamar a las APIs reales. Imprescindible en local sin creds.
MOCK_INTEGRATIONS=true

# --- Mercado Pago (proveedor principal de pagos MX) ------------------------
# Credenciales en mercadopago.com.mx → Tu negocio → Configuraciones → Credenciales.
#
# Entorno de pagos para ESTE deploy: mock | sandbox | production
#   mock       → sin credenciales; el comensal paga en una página interna simulada
#   sandbox    → credenciales de PRUEBA (usa los tokens _TEST)
#   production → credenciales REALES (usa los tokens _PROD)
# Default si no se setea: 'mock' cuando MOCK_INTEGRATIONS=true, si no 'sandbox'.
MP_MODE=mock
#
# Webhook secret: configurar la firma secreta en mercadopago.com.mx → Webhooks.
# El webhook valida la firma OFICIAL (x-signature: ts=..,v1=..; manifest
# id:<data.id>;request-id:<x-request-id>;ts:<ts>;).
MERCADO_PAGO_ACCESS_TOKEN_PROD=          # SECRET
MERCADO_PAGO_ACCESS_TOKEN_TEST=          # SECRET (puede llenarse con un valor cualquiera en local para mock)
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY_PROD=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY_TEST=
MERCADO_PAGO_WEBHOOK_SECRET=             # SECRET, requerido por la firma del webhook

# --- Resend (correo transaccional) -----------------------------------------
RESEND_API_KEY=                          # SECRET
RESEND_FROM_EMAIL=hola@kobi.mx

# --- Sentry (observabilidad) -----------------------------------------------
NEXT_PUBLIC_SENTRY_DSN_OMS=
NEXT_PUBLIC_SENTRY_DSN_STOREFRONT=
SENTRY_AUTH_TOKEN=                       # SECRET, usado por build para subir source maps
SENTRY_ORG=
SENTRY_PROJECT_OMS=kobi-oms
SENTRY_PROJECT_STOREFRONT=kobi-storefront

# --- Mapbox (mapas wizard + storefront tracking) ---------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Stripe (legacy, queda como fallback) ----------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Uber Direct (logística para sitio propio) -----------------------------
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=

# --- Uber Eats Marketplace API ---------------------------------------------
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
UBER_EATS_STORE_ID=

# --- Rappi Partners API -----------------------------------------------------
RAPPI_API_KEY=
RAPPI_STORE_ID=

# --- Didi Food Partners API -------------------------------------------------
DIDI_API_KEY=
DIDI_STORE_ID=

# --- App URLs ---------------------------------------------------------------
NEXT_PUBLIC_OMS_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001
NEXT_PUBLIC_CLOCK_URL=http://localhost:3002

# --- Visión (importador de menú por fotos) -----------------------------------
ANTHROPIC_API_KEY=                       # SECRET — solo server-side (apps/oms)
MENU_VISION_MODEL=                       # opcional; default claude-opus-4-8 (alternativas: claude-sonnet-4-6, claude-haiku-4-5)
