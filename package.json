{
  "name": "lidxi-os",
  "version": "0.1.0",
  "private": true,
  "description": "LidxiOS — OMS para dark kitchens con integraciones nativas (Uber Eats, Rappi, Didi, Uber Direct)",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "init:env": "node scripts/setup.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:start": "pnpm --filter @lidxi/db db:start",
    "db:stop": "pnpm --filter @lidxi/db db:stop",
    "db:reset": "pnpm --filter @lidxi/db db:reset",
    "db:types": "pnpm --filter @lidxi/db db:types",
    "db:demo-reset": "pnpm --filter @lidxi/db demo-reset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@types/node": "20.16.11",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "turbo": "2.2.3",
    "typescript": "5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": ["biome check --write --no-errors-on-unmatched"]
  }
}
