{
  "name": "@kobi/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "type-check": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types.gen.ts || echo 'Supabase CLI no disponible o stack no levantado. Corre pnpm db:start primero.'",
    "demo-reset": "node scripts/demo-reset.mjs"
  },
  "dependencies": {
    "@kobi/shared": "workspace:*",
    "@supabase/ssr": "0.5.1",
    "@supabase/supabase-js": "2.45.4",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "typescript": "5.6.3"
  }
}
